# ── Database ──────────────────────────────────────────────────────────────────
# Prisma Accelerate URL (runtime client)
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_KEY"

# Direct Postgres connection.
# Migrations use this URL. The worker uses it for PDF chunk inserts and embedding updates.
DIRECT_URL="postgresql://user:password@localhost:5432/research"

# ── AI ────────────────────────────────────────────────────────────────────────
# Required for embeddings and OpenAI chat models
OPENAI_API_KEY="sk-..."

# Optional — enable Anthropic and Google models in the model picker
ANTHROPIC_API_KEY="sk-ant-..."
GOOGLE_GENERATIVE_AI_API_KEY="..."

# ── Redis (BullMQ) ────────────────────────────────────────────────────────────
# Local docker-compose Redis:
REDIS_HOST="localhost"
REDIS_PORT="6379"
# Upstash: paste the TCP connection string from Connect → TCP.
# This overrides REDIS_HOST / REDIS_PORT. Leave it unset for local Redis.
# REDIS_URL="rediss://default:YOUR_TOKEN@YOUR_ENDPOINT:6379"

# ── API ───────────────────────────────────────────────────────────────────────
PORT="3001"
CORS_ORIGIN="http://localhost:3000"

# ── Web ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"

# ── Auth (Better Auth, runs in Next.js) ───────────────────────────────────────
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Usage limits ──────────────────────────────────────────────────────────────
DOCUMENTS_PER_DAY="5"
QUESTIONS_PER_DAY="25"
MAX_PDF_PAGES="100"
MAX_PDF_SIZE_MB="10"
MAX_CHUNKS="400"
